# Copy to .env and fill in. Never commit .env.

# Code instructors must enter to create an instructor account. Share it only with teaching staff.
TEACHER_ACCESS_CODE=change-me-to-something-long

# Only emails at this domain can sign up. Leave empty to allow any email.
ALLOWED_EMAIL_DOMAIN=dartmouth.edu

# Where the SQLite database lives (default: server/data/dalt.db). Back this file up.
# DATABASE_FILE=/var/lib/dalt/dalt.db

PORT=8787

# Set to production when deployed behind HTTPS (turns on Secure cookies and requires TEACHER_ACCESS_CODE).
# NODE_ENV=production

# ---------- Dartmouth single sign-on (SAML) ----------
# The site's public address (used for the sign-in return URL). Required when SSO is on.
# PUBLIC_URL=https://arabic.dartmouth.edu

# From Dartmouth ITC once they register the site:
# SAML_ENTRY_POINT=https://login.dartmouth.edu/...   (their SSO URL)
# SAML_IDP_CERT=/path/to/dartmouth-idp.pem            (their signing certificate, file path or PEM text)

# Optional:
# SAML_ISSUER=https://arabic.dartmouth.edu/api/auth/sso/metadata   (our entity ID; this is the default)
# SAML_SP_PRIVATE_KEY=/path/to/sp.key  SAML_SP_CERT=/path/to/sp.crt (only if ITC asks for signed requests or encrypted assertions)
# SAML_EMAIL_ATTRIBUTE=  SAML_NAME_ATTRIBUTE=   (if Dartmouth uses unusual attribute names)
# SAML_WANT_RESPONSE_SIGNED=false

# Instructors whose Dartmouth sign-in should get instructor tools automatically (comma-separated).
# TEACHER_EMAILS=khalid.mansour@dartmouth.edu,layla.haddad@dartmouth.edu

# Email + password sign-in: defaults to OFF when SSO is configured, ON otherwise. Override with on/off.
# PASSWORD_LOGIN=off

# ---------- Daal, the AI Arabic tutor (Claude) ----------
# Create a key at https://platform.claude.com (Settings → API keys). Without it, Daal still quizzes and guides,
# but the AI tools (Ask, Talk, Check, Quiz me, "Why?") are switched off.
# ANTHROPIC_API_KEY=sk-ant-...
# DAAL_MODEL=claude-opus-5-5        # default
# DAAL_EFFORT=low                   # low | medium | high — how hard Daal thinks per reply (cost vs. depth)
# DAAL_LIMIT_PER_10_MIN=30          # per student
# DAAL_LIMIT_PER_DAY=300            # per student

# ---------- Pronunciation: Microsoft Azure AI Speech ----------
# From your Azure "Speech" resource → Keys and Endpoint. Without these, the site uses browser voices.
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=eastus                       # the resource's region
# AZURE_SPEECH_ENDPOINT=                           # optional: full URL instead of region (e.g. sovereign clouds)
# AZURE_SPEECH_VOICE=ar-SA-HamedNeural             # default: ar-SA-HamedNeural or ar-SA-ZariyahNeural (MSA only)
# AZURE_SPEECH_ENGLISH_VOICE=en-US-JennyNeural     # reads any English mixed into the text
# TTS_CACHE_DIR=                                   # default server/data/tts-cache — generated clips are reused forever
